# Top-level .env.example - shared environment variables for the monorepo
# Copy this file to the service-specific `.env.local` or platform secrets.
# DO NOT commit real secrets. Use your deployment platform (Vercel) to store
# production secrets and only keep placeholders here.

# ---------------------------
# Common / Shared variables
# ---------------------------
# API endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SpartanEdge

# Upload and partner integration (server-side)
# Comma-separated list of API keys trusted for uploads (B2B). Example: key1,key2
UPLOAD_API_KEYS=your-upload-api-key-1,your-upload-api-key-2

# Comma-separated list of allowed origins for upload CORS (exact origins)
ALLOWED_UPLOAD_ORIGINS=http://localhost:3000,https://your-partner.com

# Optional maximum image size in MB (server-side). Defaults are used if missing.
MAX_IMAGE_SIZE_MB=10

# Firebase admin service account JSON (string) OR path to JSON file on server.
# Prefer storing the JSON object in your secret store (e.g. Vercel env var).
FIREBASE_SERVICE_ACCOUNT='' # (JSON string) OR leave empty and set FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json

# Cloudinary (optional fallback storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google / Gemini keys (AI features - usado para todas las herramientas de IA)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-google-api-key
GOOGLE_VISION_SERVICE_ACCOUNT_PATH=path/to/google-vision-sa.json

# ---------------------------
# Payments - MercadoPago (LATAM)
# ---------------------------
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# ---------------------------
# Payments - Stripe (Global)
# ---------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ---------------------------
# Database & Cache
# ---------------------------
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Upstash Redis (optional - for rate limiting and caching)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ---------------------------
# Monitoring (optional)
# ---------------------------
SENTRY_DSN=

{
  "name": "spartan-club-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spartan Club - Frontend con Next.js",
  "scripts": {
    "dev": "node -e \"require('dotenv').config({path: '.env.local', override: true})\" && next dev --turbo",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "node -e \"require('dotenv').config({path: '.env.local', override: true})\" && prisma generate",
    "prisma:validate": "node -e \"require('dotenv').config({path: '.env.local', override: true})\" && prisma validate",
    "prisma:migrate": "node -e \"require('dotenv').config({path: '.env.local', override: true})\" && prisma migrate deploy",
    "prisma:seed": "node -e \"require('dotenv').config({path: '.env.local', override: true})\" && prisma db seed",
    "prisma:studio": "node -e \"require('dotenv').config({path: '.env.local', override: true})\" && prisma studio",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "test": "npx tsx tests/run-all.ts",
    "test:payments": "npx tsx tests/payments/flow.test.ts",
    "test:users": "npx tsx tests/users/signup-bonus.test.ts",
    "test:asesor-estilo": "npx tsx tests/asesor-estilo/config.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.436.0",
    "@aws-sdk/s3-request-presigner": "^3.436.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@stripe/stripe-js": "^8.5.3",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "^2.0.1",
    "cloudinary": "^2.8.0",
    "dotenv": "^17.2.3",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.8",
    "next-intl": "^4.5.6",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
    "probe-image-size": "^7.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "streamifier": "^0.1.1",
    "stripe": "^20.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.7",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.19.26",
    "@types/pg": "^8.15.6",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/streamifier": "^0.1.2",
    "@types/swiper": "^5.4.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "^15.3.8",
    "prisma": "^7.4.2",
    "swiper": "^11.2.8",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": ">=10.0.0",
    "postcss": ">=8.5.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

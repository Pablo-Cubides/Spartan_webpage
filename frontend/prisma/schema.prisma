generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  uid             String    @unique
  email           String    @unique
  name            String?
  alias           String?   @unique
  avatar_id       String?
  role            String    @default("user")
  credits         Int       @default(0)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime?
  purchases       Purchase[]
  posts           BlogPost[]
  spartanProfile  SpartanProfile?
  creditUsage     CreditUsage[]
}

model CreditPackage {
  id         Int      @id @default(autoincrement())
  name       String
  credits    Int
  price      Float
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime?
  purchases  Purchase[]
}

model Purchase {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [user_id], references: [id])
  user_id          Int
  package          CreditPackage @relation(fields: [package_id], references: [id])
  package_id       Int
  amount_paid      Float
  credits_received Int
  payment_method   String?
  payment_id       String?
  status           String   @default("pending")
  created_at       DateTime @default(now())
  completed_at     DateTime?
}

model AppSetting {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @updatedAt
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  start_date  DateTime
  end_date    DateTime
  is_active   Boolean  @default(true)
  type        String   @default("info")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// =============================================
// Blog Models
// =============================================

model BlogCategory {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  epic_name       String
  description     String
  meta_title      String?
  meta_description String?
  icon            String?
  cover_image     String?
  gradient        String?    // Added for UI styling (e.g. "from-red-600 to-orange-600")
  order           Int        @default(0)
  is_active       Boolean    @default(true)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  posts           BlogPost[]
}

model BlogPost {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  content         String
  excerpt         String?
  cover_image     String?
  
  // Relation to Category
  category_slug   String?
  category        BlogCategory? @relation(fields: [category_slug], references: [slug])
  
  meta_title      String?
  meta_description String?
  keywords        String[]
  author_id       Int
  author          User      @relation(fields: [author_id], references: [id])
  is_published    Boolean   @default(false)
  published_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

// =============================================
// Coach Espartano Models
// =============================================

// User's coaching profile with goals and preferences
model SpartanProfile {
  id             Int      @id @default(autoincrement())
  user_id        Int      @unique
  user           User     @relation(fields: [user_id], references: [id])
  mainGoal       String?
  subGoals       String[] // Array of sub-objectives
  levels         Json?    // { body: "novice", style: "intermediate", ... }
  restrictions   Json?    // { time: "2h/week", budget: "low", ... }
  preferences    Json?    // { gym: false, homeWorkout: true, ... }
  currentFocuses String[]
  enabledCoaches String[] @default([]) // ["general", "cuerpo", "estilo", ...]
  strategistPlan Json?    // Layer 2 internal guidance
  onboardingDone Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  conversations  CoachConversation[]
}

// Conversation with a specific coach
model CoachConversation {
  id           Int            @id @default(autoincrement())
  profile      SpartanProfile @relation(fields: [profile_id], references: [id])
  profile_id   Int
  coachType    String         // "general", "cuerpo", "estilo", "mentalidad", "productividad"
  messages     CoachMessage[]
  welcomeShown Boolean        @default(false)
  messageCount Int            @default(0)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  
  @@unique([profile_id, coachType])
}

// Individual messages in a conversation (encrypted)
model CoachMessage {
  id             Int               @id @default(autoincrement())
  conversation   CoachConversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  role           String            // "user" | "assistant" | "system"
  content        String            // Encrypted content
  created_at     DateTime          @default(now())
}

// Free message tracking per month
model CoachFreeMessages {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  count      Int      @default(0)
  monthYear  String   // "2024-12" format
  updated_at DateTime @updatedAt
}

// Community analytics (aggregated, anonymized)
model CoachAnalytics {
  id           Int      @id @default(autoincrement())
  reportDate   DateTime
  reportType   String   // "monthly", "on_demand"
  content      String   // JSON report content
  userCount    Int
  messageCount Int
  created_at   DateTime @default(now())
}

// =============================================
// Credit Usage History
// =============================================

// Tracks every credit consumption for auditing
model CreditUsage {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [user_id], references: [id])
  user_id       Int
  amount        Int      // Credits consumed (positive) or added (negative for refunds)
  operation     String   // "analyze", "generate", "edit", "refund", etc.
  description   String?  // Optional details
  balance_after Int      // User's balance after this operation
  metadata      Json?    // Additional context (session_id, tool, etc.)
  created_at    DateTime @default(now())

  @@index([user_id])
  @@index([created_at])
}


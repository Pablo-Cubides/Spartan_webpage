# =============================================================================
# SPARTAN CLUB - Environment Variables Configuration
# =============================================================================
#
# This file contains all environment variables needed for the Spartan Club app.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in your actual values (replace placeholders starting with 'your-')
# 3. NEVER commit .env.local or real secrets to version control
# 4. For production (Vercel), add these as Environment Variables in the dashboard
#
# LEGEND:
# [REQUIRED]    - Must be configured for the app to function
# [PRODUCTION]  - Required specifically for production deployment
# [OPTIONAL]    - Not required, has sensible defaults
#
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Spartan Club

# =============================================================================
# [REQUIRED] DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Recommended: Supabase, Neon, or PlanetScale for serverless
DATABASE_URL=postgresql://user:password@localhost:5432/spartan_dev

# =============================================================================
# [REQUIRED] FIREBASE AUTHENTICATION
# =============================================================================
# Client-side configuration (NEXT_PUBLIC_ prefix = exposed to browser)
# Get these from: Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-side configuration (private - never expose to client)
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Note: Keep the newlines as \n - they will be parsed correctly
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =============================================================================
# [REQUIRED] GOOGLE GEMINI AI
# =============================================================================
# Get from: https://makersuite.google.com/app/apikey
# You can use the same key for all tools, or separate keys for billing/quota control

# Face shape analyzer (asesor-forma-cara)
GEMINI_API_KEY_FACE=your-gemini-api-key

# Clothing/style advisor (asesor-estilo) 
GEMINI_API_KEY_CLOTHING=your-gemini-api-key

# Coach Espartano AI chat
GEMINI_API_KEY_COACH=your-gemini-api-key

# Fallback key (used if specific tool key is not set)
GEMINI_API_KEY=your-gemini-api-key

# AI Model Overrides (defaults: gemini-2.5-flash for analysis/coach, gemini-3.1-flash-image for image generation)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_COACH_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# =============================================================================
# [REQUIRED] CLOUDINARY - Image Processing
# =============================================================================
# For image uploads, transformations, and AI image editing
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =============================================================================
# [REQUIRED] MERCADOPAGO - Payment Processing
# =============================================================================
# For credit purchases in LATAM markets
# Get from: https://www.mercadopago.com/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key

# [PRODUCTION REQUIRED] Webhook signature verification
# Get from: MercadoPago Developer Dashboard > Webhooks
# CRITICAL: Without this, webhooks are NOT verified in production!
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# [REQUIRED] STRIPE - Global Payment Processing
# =============================================================================
# For international credit purchases (USD)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key

# [PRODUCTION REQUIRED] Webhook signature verification
# Get from: Stripe Dashboard > Developers > Webhooks > Signing secret
# CRITICAL: Without this, webhooks are NOT verified!
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =============================================================================
# [OPTIONAL] REDIS CACHE - Performance Optimization
# =============================================================================
# Recommended: Upstash Redis for serverless environments
# Without Redis, the app will use in-memory cache (works but less efficient)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
# Alternative format (both work)
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your-redis-token

# =============================================================================
# [OPTIONAL] AWS S3 / CLOUDFLARE R2 - Alternative Storage
# =============================================================================
# If you want to use S3/R2 instead of or alongside Cloudinary
# R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=spartan-uploads
# R2_REGION=auto

# AWS S3 alternative
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET_NAME=your-bucket
# AWS_REGION=us-east-1

# =============================================================================
# [PRODUCTION REQUIRED] SECURITY
# =============================================================================
# Comma-separated list of allowed origins for file uploads
# In development, leave empty or set to localhost
# In production, set to your actual domain(s)
ALLOWED_UPLOAD_ORIGINS=http://localhost:3000

# API keys for server-to-server upload authentication (optional)
# UPLOAD_API_KEYS=key1,key2,key3

# =============================================================================
# [OPTIONAL] AI SERVICE CONFIGURATION
# =============================================================================
# Timeouts in milliseconds
AI_ANALYSIS_TIMEOUT=45000
AI_GENERATION_TIMEOUT=60000
AI_MAX_RETRIES=2
AI_RETRY_DELAY=2000

# Circuit breaker settings
AI_CIRCUIT_THRESHOLD=5
AI_CIRCUIT_RESET=30000

# =============================================================================
# [OPTIONAL] CREDIT SYSTEM
# =============================================================================
# Cost per operation (set all to 0 for free/testing)
CREDIT_COST_ANALYSIS=1
CREDIT_COST_GENERATION=1
# Coach Espartano: messages consumed before spending 1 credit
COACH_MESSAGES_PER_CREDIT=5
# Starting credits for new users (2 is default)
STARTING_CREDITS=2
# Set to false to disable credit checking (for testing)
ENFORCE_CREDITS=true

# =============================================================================
# [OPTIONAL] RATE LIMITING
# =============================================================================
# Enabled automatically in production, disabled in development
RATE_LIMIT_ENABLED=false
# Maximum requests per window
RATE_LIMIT_MAX=100
RATE_LIMIT_ITERATIONS=50
# Window duration in seconds (3600 = 1 hour)
RATE_LIMIT_WINDOW=3600

# =============================================================================
# [OPTIONAL] IMAGE VALIDATION
# =============================================================================
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_WIDTH=512
MIN_IMAGE_HEIGHT=512
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =============================================================================
# [OPTIONAL] CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
# TTL in seconds (604800 = 7 days)
CACHE_TTL=604800

# =============================================================================
# [OPTIONAL] FEATURE FLAGS
# =============================================================================
MODERATION_ENABLED=true
WATERMARK_ENABLED=true
ANALYTICS_ENABLED=false

# =============================================================================
# [OPTIONAL] COMPLIANCE & PRIVACY
# =============================================================================
# Auto-delete uploaded images after processing
DELETE_IMAGES_AFTER=false
# Retention period for generated images (days)
IMAGE_RETENTION_DAYS=30
# Don't log image URLs for privacy
PRIVACY_MODE=false

# =============================================================================
# [OPTIONAL] MONITORING & DEBUGGING
# =============================================================================
MONITORING_ENABLED=false
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
LOG_LEVEL=info

# =============================================================================
# [OPTIONAL] EMAIL SERVICE
# =============================================================================
# For transactional emails (purchase confirmations, newsletter, etc.)
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=spartanmarketcol@gmail.com

# Template IDs from Brevo dashboard
BREVO_TEMPLATE_WELCOME=1
BREVO_TEMPLATE_NEWSLETTER=2
BREVO_TEMPLATE_PURCHASE=3
BREVO_TEMPLATE_CREDIT_LOW=4

# Contact List IDs from Brevo dashboard
BREVO_LIST_NEWSLETTER=1
BREVO_LIST_USERS=2
